# SMTP används bland annat för lösenordsåterställning.
# SMTPS använder normalt port 465 och SMTP_USE_SSL=True.
# STARTTLS använder normalt port 587 och SMTP_USE_STARTTLS=True.
SMTP_HOST='smtp.example.com'
SMTP_PORT=587
SMTP_USE_SSL=False
SMTP_USE_STARTTLS=True
SMTP_USERNAME='username@example.com'
SMTP_PASSWORD='password'
SMTP_FROM='username@example.com'
SWISH_NUMBER=''
NAVBAR_LOGO='img/logo_64.jpg'